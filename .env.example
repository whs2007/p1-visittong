# ===== 拜访通 P1 配置示例（复制为 .env 后按需修改）=====
# 说明：不配置 LLM_API_KEY 时自动使用 Mock 模式，可离线演示。

# ---------- 鉴权（生产必须修改 AUTH_SECRET）----------
AUTH_MODE=strict                      # strict=只认 Bearer Token；demo=额外允许 X-User-Id（仅本地回环）
AUTH_SECRET=change-me-to-a-random-32-bytes
AUTH_TOKEN_TTL_H=8
DEMO_PASSWORD=123456                  # 仅用于初始化演示账号 sales-001 / manager-001
# AUTH_ALLOW_INSECURE_SECRET=1        # 仅本地/CI：允许用默认 AUTH_SECRET 启动。生产绝不要开
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_SECONDS=300
# 跨域白名单，逗号分隔。默认（留空）= 不放行任何跨域；前后端同源时无需配置。
# 本地前后端分离开发示例：ALLOWED_ORIGINS=http://127.0.0.1:5173
ALLOWED_ORIGINS=

# ---------- LLM（OpenAI 兼容协议）----------
# mock=离线关键词规则（默认，无需 Key）；live=真模型；auto=有 Key 就走 live
LLM_MODE=mock
# 任意 OpenAI 兼容端点。阿里云百炼示例（实测 qwen-flash 一档最省，且支持 function calling）：
#   LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   LLM_MODEL=qwen-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=                          # 只写本文件（.env 已被 .gitignore 忽略），绝不提交
LLM_MODEL=deepseek-v4.1-flash
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_S=60
# 压缩摘要是否交给真模型（失败/超时自动回退确定性摘要，不影响 Turn 完成）
LLM_SUMMARY=true

# ---------- 记忆（Pi 的 AGENTS.md 分层 + 长期记忆）----------
ENABLE_MEMORY=true
MEMORY_DIR=memory                     # 相对项目根：AGENTS.md / agents/<name>.md
MEMORY_RECALL_K=4                     # 单轮注入的动态记忆条数上限
MEMORY_MIN_SCORE=0.16                 # 召回相似度下限
MEMORY_LAYER_MAX_CHARS=1600           # 单层记忆文件注入上限

# ---------- 存储 ----------
# Redis >= 6 推荐；Redis 5 也可用（客户端已强制 RESP2）。连不上自动降级内存，health 会给出原因。
REDIS_URL=redis://127.0.0.1:6379/0
SQLITE_PATH=data/visittong.db
SESSION_TTL_S=1800
CONTEXT_LIMIT=40

# ---------- 运行时 ----------
APPROVAL_TIMEOUT_S=120
TOOL_TIMEOUT_S=20
MAX_LOOP=6
DISTANCE_OK_M=500
DISTANCE_APPROVAL_M=2000
SEED_DEMO=true
HOST=127.0.0.1
PORT=8020
# 多 worker：WEB_CONCURRENCY>1 时，除首个进程外都要 RECONCILE_ON_START=0，
# 否则每个 worker 都会把别人的 running 记成 unknown（崩溃对账只能有一个执行者）。
WEB_CONCURRENCY=1
RECONCILE_ON_START=1

# ---------- 上下文压缩 / 成本（可选）----------
ENABLE_COMPACTION=true
CONTEXT_TOKEN_BUDGET=6000
COMPACTION_KEEP_RECENT=12
PRICE_IN_PER_MTOK=0                 # 每百万输入 token 的单价（0 = 只报 token 不报钱）
PRICE_OUT_PER_MTOK=0

# ---------- 工具输出治理（脱敏 / 裁剪 / 引用化）----------
TOOL_OUTPUT_MAX_CHARS=1600           # 字符上限（仅 TOOL_OUTPUT_MAX_TOKENS=0 时生效）
TOOL_OUTPUT_MAX_TOKENS=900           # token 上限（默认走这条；字符→token 换算随形态浮动 1.7 倍）
TOOL_OUTPUT_HEAD_RATIO=0.7           # 裁剪后首部占比（尾部保留错误码/汇总行）
PII_REDACT=true                      # 手机 / 身份证 / 银行卡 / 邮箱掩码

# ---------- 检索（混合排序）----------
KNOWLEDGE_MODE=hybrid                # hybrid = IDF 覆盖度 + BM25；vector = v0.9 的 n-gram 哈希
KNOWLEDGE_MIN_SCORE=0.38             # 融合分阈值（0.35→0.38：负例误召回 16.7%→8.3%，召回不变）
KNOWLEDGE_AUTOBIND_COVERAGE=0.5      # 自动绑定要求覆盖率过半，否则只给候选卡

# ---------- 降级策略 ----------
STRICT_DEGRADE=0                     # 1 = 出现 critical 降级（如 Redis 配了却退内存锁）拒绝启动

# ---------- 告警阈值（/api/metrics 的 alerts）----------
ALERT_FAILURE_RATE=0.15
ALERT_APPROVAL_TIMEOUT_RATE=0.10
ALERT_MIN_SAMPLES=20                 # 样本不足不报警，避免冷启动一片红
# ---------- 路由 / 知识 / 录音 / 存储后端（v0.4）----------
ROUTER_MODE=hybrid                   # rules | hybrid | llm
ROUTER_CONFIDENCE_MIN=0.6
DB_BACKEND=sqlite                    # sqlite | mysql（MySQL 需 pip install pymysql 与真实实例）
MYSQL_DSN=mysql://user:password@127.0.0.1:3306/visittong
ASR_BACKEND=mock                     # mock | faster_whisper | command
ASR_MODEL=small
ASR_LANGUAGE=zh
ASR_COMMAND=                         # 例：python asr_gateway.py --file {file}
AUDIO_DIR=data/audio
KNOWLEDGE_BACKEND=local              # local | milvus
KNOWLEDGE_DIM=256
MILVUS_URI=                          # 例：http://127.0.0.1:19530
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SCORE=0.35
